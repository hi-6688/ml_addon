# Minecraft Bedrock Addon - Local Environment Configurations Template

# 1. Minecraft Bedrock Engine & Script API (SAPI) Versions
MINECRAFT_MIN_ENGINE_VERSION="1.21.0"
SAPI_SERVER_VERSION="2.8.0" # Official Stable release (@minecraft/server v2.8.0)
SAPI_SERVER_UI_VERSION="2.1.0" # Official Stable release (@minecraft/server-ui v2.1.0)
REQUIRE_BETA_APIS=false

# 2. Script Debugger Settings
BDS_DEBUGGER_ENABLE=true
BDS_DEBUGGER_PORT=19144

# 3. Build & Packaging Options
PACK_OUTPUT_DIR="./out"
NAMESPACE="ml_mod"

# 4. Local Development Paths (Optional for local symlink/sync)
# LOCAL_MOJANG_BP_PATH="%localappdata%/Packages/Microsoft.MinecraftUWP_8wekyb3d8bbwe/LocalState/games/com.mojang/development_behavior_packs"
# LOCAL_MOJANG_RP_PATH="%localappdata%/Packages/Microsoft.MinecraftUWP_8wekyb3d8bbwe/LocalState/games/com.mojang/development_resource_packs"
